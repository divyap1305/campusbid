# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campusbid

# Authentication
JWT_SECRET=campusbid_jwt_secure_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Campus Eligibility
ALLOWED_EMAIL_DOMAINS=campus.edu,student.edu,college.edu,gmail.com

# Optional Cloudinary (Local uploads used if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI Assistant API Key (Falls back to deterministic intelligent assistant)
GEMINI_API_KEY=
